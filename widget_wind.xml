<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ВЯТЪР · ВАРНА"
            android:textColor="#EAF5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РК ВАРНА"
                android:textColor="#AFC5D9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rk_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="— m/s"
                android:textColor="#73E6C2"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rk_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Порив — m/s"
                android:textColor="#D6E7F8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/rk_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Посока —°"
                android:textColor="#91A9BE"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#3FFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="БЦ ВАРНА"
                android:textColor="#AFC5D9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bc_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="— m/s"
                android:textColor="#73E6C2"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bc_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Порив — m/s"
                android:textColor="#D6E7F8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bc_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Посока —°"
                android:textColor="#91A9BE"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Обновено —"
        android:textColor="#91A9BE"
        android:textSize="9sp" />

</LinearLayout>
