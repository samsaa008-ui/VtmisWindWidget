<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ВЯТЪР · ВАРНА"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@android:color/white"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РК Варна"
                android:textColor="#DCEBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rk_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="— m/s"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rk_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="порив — m/s"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rk_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—°"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="8dp"
            android:background="#55FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="БЦ Варна"
                android:textColor="#DCEBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bc_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="— m/s"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bc_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="порив — m/s"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bc_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—°"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Обновено: —"
        android:textColor="#C8DAEF"
        android:textSize="11sp" />

</LinearLayout>
