<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вятър — Варна"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rk_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="РК Варна: —"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/bc_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="БЦ Варна: —"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Последно обновяване: —" />

    <Button
        android:id="@+id/refresh_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Обнови сега" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="За да добавиш widget: задръж върху празно място на началния екран → Widgets → „Вятър Варна“."
        android:textSize="16sp" />

</LinearLayout>
