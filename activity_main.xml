<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071019"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_dashboard_background"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <!-- Заглавие -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="ВЯТЪР · ВАРНА"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/refresh_now"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="↻"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45FFFFFF" />

            <!-- РК ВАРНА -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <!-- Станция -->
                <LinearLayout
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="46dp"
                        android:contentDescription="РК Варна"
                        android:src="@drawable/ic_windsock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="РК ВАРНА"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Скорост -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="Скорост"
                            android:src="@drawable/ic_wind"
                            android:tint="#42D7C7" />

                        <TextView
                            android:id="@+id/rk_speed_value"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="m/s"
                            android:textColor="#42D7C7"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="СКОРОСТ"
                        android:textColor="#C3D0DC"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="62dp"
                    android:background="#45FFFFFF" />

                <!-- Порив -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="Порив"
                            android:src="@drawable/ic_gust"
                            android:tint="#FFD05A" />

                        <TextView
                            android:id="@+id/rk_gust_value"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="m/s"
                            android:textColor="#FFD05A"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="ПОРИВ"
                        android:textColor="#C3D0DC"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="62dp"
                    android:background="#45FFFFFF" />

                <!-- Посока -->
                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/compass_circle">

                        <ImageView
                            android:id="@+id/rk_arrow"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Посока"
                            android:src="@drawable/ic_direction_arrow"
                            android:tint="#42D7C7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/rk_direction_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—°"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rk_direction_name"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#34BFE7"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45FFFFFF" />

            <!-- БЦ ВАРНА -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <!-- Станция -->
                <LinearLayout
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="46dp"
                        android:contentDescription="БЦ Варна"
                        android:src="@drawable/ic_lighthouse" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="БЦ ВАРНА"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Скорост -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="Скорост"
                            android:src="@drawable/ic_wind"
                            android:tint="#42D7C7" />

                        <TextView
                            android:id="@+id/bc_speed_value"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="m/s"
                            android:textColor="#42D7C7"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="СКОРОСТ"
                        android:textColor="#C3D0DC"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="62dp"
                    android:background="#45FFFFFF" />

                <!-- Порив -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="Порив"
                            android:src="@drawable/ic_gust"
                            android:tint="#FFD05A" />

                        <TextView
                            android:id="@+id/bc_gust_value"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="m/s"
                            android:textColor="#FFD05A"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="ПОРИВ"
                        android:textColor="#C3D0DC"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="62dp"
                    android:background="#45FFFFFF" />

                <!-- Посока -->
                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/compass_circle">

                        <ImageView
                            android:id="@+id/bc_arrow"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Посока"
                            android:src="@drawable/ic_direction_arrow"
                            android:tint="#42D7C7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/bc_direction_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—°"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/bc_direction_name"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#34BFE7"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45FFFFFF" />

            <!-- Последно обновяване -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="◷"
                    android:textColor="#42D7C7"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:text="Обновено —"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
